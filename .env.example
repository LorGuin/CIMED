# Copiá este archivo a .env y completá con las credenciales reales del proyecto de Firebase
# (Firebase Console -> Configuración del proyecto -> Tus apps -> SDK setup and configuration).
# .env nunca se sube a git (ver .gitignore) — en Netlify, estas mismas variables se cargan
# en Site settings -> Environment variables, no en un archivo.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Chatbot Mario — la usa SOLO netlify/functions/mario.ts (del lado del servidor), por eso a
# propósito NO lleva el prefijo VITE_: si lo llevara, Vite la empaquetaría en el código del
# navegador y cualquiera podría copiarla. Se consigue gratis (sin tarjeta) en
# https://console.groq.com. En producción se carga en Netlify -> Site settings -> Environment
# variables, no en este archivo.
GROQ_API_KEY=
